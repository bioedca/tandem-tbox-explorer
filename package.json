{
  "name": "tbdb-tandem",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "tbdb.tandem — a static explorer for the 470 tandem T-box riboswitch loci (companion to tbdb.io).",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:toolchain": "node ./scripts/verify-typescript7.mjs",
    "check": "npm run check:toolchain && svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json",
    "typecheck": "node ./node_modules/@typescript/native-preview/bin/tsc --noEmit --project ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.8",
    "@molbiohive/hatchlings": "0.8.4",
    "d3": "^7.9.0",
    "fornac": "^1.1.0",
    "phylotree": "^2.0.0",
    "plotly.js-dist-min": "^3.7.0",
    "svelte-spa-router": "^5.1.1",
    "tabulator-tables": "^6.5.2",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.0",
    "@typescript/native-preview": "npm:typescript@7.0.2",
    "@types/tabulator-tables": "^6.3.6",
    "@types/three": "0.185.1",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.7",
    "svelte-check": "4.7.3",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
